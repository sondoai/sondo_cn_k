{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // --- sdk --- bundleManager.canOpenLink 只能查询这里声明过的 scheme：
    //   alipays            SDPayModule.alipayIsInstalled / 支付宝收银台、自动续费签约
    //   weixin / wxopensdk SDAuthModule.wechatIsInstalled / 微信 OpenSDK 拉起微信
    "querySchemes": [
      "alipays",
      // 支付宝 SDK README 要求（未装支付宝时判断 / 转 H5 支付）
      "https",
      "weixin",
      "wxopensdk"
    ],
    // --- sdk --- Push Kit（极光推送鸿蒙通道）要求的应用级 Client ID：
    //   AppGallery Connect > 我的项目 > 项目设置 > 常规 > 应用 > Client ID（不是项目级的那个）。
    //   占位值不影响编译和启动，但拿不到 Push Token（收不到推送），上线前必须替换。
    "metadata": [
      {
        "name": "client_id",
        "value": "REPLACE_WITH_AGC_APP_CLIENT_ID"
      }
    ],
    "requestPermissions": [
      // --- core ---
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // SDAppModule.haptic
        "name": "ohos.permission.VIBRATE"
      },
      {
        // SDPermissionModule "camera"（仅当业务自己开相机时需要；只用系统相机 Picker 可删除）
        "name": "ohos.permission.CAMERA",
        "reason": "$string:permission_camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // SDPermissionModule "microphone"
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
      // --- media ---
      // 媒体模块 / 原生视图只需要上面 core 已声明的 INTERNET（在线音视频、视频缓存、网页、网络 Lottie）。
      // 选图 / 拍照 / 选文件 / 存相册全部走系统 Picker 与系统授权弹窗（photoAccessHelper、cameraPicker、
      // DocumentViewPicker、showAssetsCreationDialog），不需要声明 READ_IMAGEVIDEO / WRITE_IMAGEVIDEO / CAMERA。
      // --- sdk ---
      // 支付宝 / 微信 / 极光推送 / 友盟只需要上面 core 已声明的 INTERNET 与 GET_NETWORK_INFO。
      // 通知权限不在这里声明：由 notificationManager.requestEnableNotification 运行时申请。
      // 没有声明 ohos.permission.APP_TRACKING_CONSENT（OAID，极光 / 友盟的可选项）：需要时见 ets/kuikly/modules/sdk/README.md。
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "orientation": "portrait",
        "launchType": "singleton",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home",
              // --- sdk --- 微信 OpenSDK 授权后回跳本应用用的 action（回跳 Want 走 onNewWant → AppEvents）
              "wxentity.action.open"
            ]
          },
          {
            // Deep Link：sondo://…
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "sondo"
              }
            ]
          },
          {
            // App Linking：https://go.sondo.vip/link…（需在 AGC 开通 App Linking 并在域名下部署 applinking.json）
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "go.sondo.vip",
                "pathStartWith": "link"
              }
            ],
            "domainVerify": true
          }
        ]
      }
    ]
  }
}
