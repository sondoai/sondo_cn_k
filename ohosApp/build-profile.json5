{
  "app": {
    // 签名材料来自 Flutter 旧工程 ohos/build-profile.json5。
    // default：本机调试证书；release：发布证书。当前产品用 default，打蒲公英或真机发布包时改为 release。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/kj/.ohos/config/default_ohos_JRfmvJGd7x8YAb0V3TVEbHf0eq2ZxWnq3HVWjbSBm8o=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B283D9BF4F27CEB50FF27C2B8B68303A267E4DEF0BBCFBA348F185DD0EB017E5738CC3D3C251046",
          "profile": "/Users/kj/.ohos/config/default_ohos_JRfmvJGd7x8YAb0V3TVEbHf0eq2ZxWnq3HVWjbSBm8o=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/kj/.ohos/config/default_ohos_JRfmvJGd7x8YAb0V3TVEbHf0eq2ZxWnq3HVWjbSBm8o=.p12",
          "storePassword": "0000001B22049FDEDC16021C406542F952FA31C872325C078A5905D88C8CC4D07CA08F7C061DCBBBB93A23"
        }
      },
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "/Users/kj/Desktop/config/sondo-cn/华为/发布证书/sondo_release.p12",
          "storePassword": "00000018EEF860BFF7C919063E918F2962B784745F2C5E02F4CAE8C89D1F9CE17E7C5EE7",
          "keyAlias": "sondo_release",
          "keyPassword": "000000188D32328DD94F439C1937BA5E55EC197E886337FC9E3878C90A23EB5FCB1C56A5",
          "signAlg": "SHA256withECDSA",
          "profile": "/Users/kj/Desktop/config/sondo-cn/华为/发布证书/sondo_release_profileRelease.p7b",
          "certpath": "/Users/kj/Desktop/config/sondo-cn/华为/发布证书/Sondo_Release_Certificate.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // @kuikly-open/render 2.x 以字节码 HAR 发布，要求 API 12（HarmonyOS 5.0.0）及 useNormalizedOHMUrl。
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": "26.0.0"
      },
      {
        // 开发期JSVM宿主单独使用本机已安装的SDK，不改变默认发布产品。
        "name": "hotReload",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.sondo.music.video.ai.hm",
        "config": [
          {
            "name": "Push Kit",
            "capability": "com.huawei.service.push.base_service"
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "hotReload"
          ]
        }
      ]
    }
  ]
}
