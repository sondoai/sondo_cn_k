<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ==== 三方 SDK（极光推送 / 极光认证 / 微信 / 支付宝）==== -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 极光认证切到蜂窝网络取号。不申请 READ_PHONE_STATE，号码由运营商网关返回。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 13+ 通知授权由 Kuikly 侧在用途说明后按需申请，授权后才初始化极光推送。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 华为 / 荣耀桌面角标（SDPushModule.setBadge）。 -->
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <!-- 极光 SDK 默认带入的可选权限，业务不使用，显式从合并清单移除。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <!-- 极光推送 SDK 的清单不带上限地声明了外部存储读写，这里和参考工程一样收敛到 Android 12L 及以下。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".SondoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 桌面入口：承载根页面 launch。LaunchTheme 只管进程启动期间的闪屏，进入 onCreate 后切回 AppTheme。
             standard 模式：页面栈是一串 Activity，singleTask 会在再次启动时把上面的页面全部清掉。 -->
        <activity
            android:name=".kuikly.KuiklyLaunchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="stateUnspecified|adjustNothing"
            android:launchMode="standard"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 普通页面容器：一个 Kuikly 页面一个实例，只在应用内部拉起。 -->
        <activity
            android:name=".kuikly.KuiklyRenderActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateUnspecified|adjustNothing"
            android:launchMode="standard"
            android:exported="false" />
        <activity
            android:name=".kuikly.KuiklyTranslucentActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:screenOrientation="behind"
            android:theme="@style/AppTheme.Translucent"
            android:windowSoftInputMode="stateUnspecified|adjustNothing"
            android:exported="false" />

        <!-- 深链入口（不可见的中转页）：sondo:// 与 App Link https://go.sondo.vip/link，过滤条件与参考工程一致。
             只把 URL 交给 AppEventHub，再回到已有页面栈或拉起启动页；不要加 excludeFromRecents（冷启动时它是任务根）。 -->
        <activity
            android:name=".kuikly.DeepLinkActivity"
            android:exported="true"
            android:launchMode="standard"
            android:noHistory="true"
            android:theme="@style/TrampolineTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sondo" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="go.sondo.vip"
                    android:path="/link" />
            </intent-filter>
        </activity>

        <!-- 对外授权 App 私有文件（系统分享、相机拍照输出）。authority 固定为 <包名>.fileprovider。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==== 三方 SDK 组件 ==== -->

        <!-- 微信回跳入口。类名、exported、singleTask + 同包名 taskAffinity 都是微信 SDK 的要求。 -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}"
            android:theme="@style/WXEntryTheme" />

        <!-- 极光一键登录授权页：从 Application Context 带 NEW_TASK 拉起，落在应用自己的任务里；
             做成贴底弹窗，两个运营商授权 Activity 换成透明窗口主题。
             排除出最近任务，避免授权页自己成为根任务时留下一张卡片。 -->
        <activity
            android:name="cn.jiguang.verifysdk.CtLoginActivity"
            android:excludeFromRecents="true"
            android:theme="@style/JverifySheetTheme"
            tools:replace="android:theme" />
        <activity
            android:name="com.cmic.gen.sdk.view.GenLoginAuthActivity"
            android:excludeFromRecents="true"
            android:theme="@style/JverifySheetTheme"
            tools:replace="android:theme" />
        <activity
            android:name="cn.jiguang.verifysdk.SmsLoginActivity"
            android:excludeFromRecents="true" />

        <!-- 极光推送回调（主进程）。 -->
        <receiver
            android:name=".sdk.push.SondoJPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVER_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>
        <!-- 极光长连接 Service：必须继承 JCommonService，和极光自己的 PushService 同在 :pushcore 进程。
             SDPushModule.setup 之前不会被拉起。 -->
        <service
            android:name=".sdk.push.SondoJPushService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore"
            android:stopWithTask="true">
            <intent-filter>
                <action android:name="cn.jiguang.user.service.action" />
            </intent-filter>
        </service>
    </application>

    <!-- Android 11+ 看不到未声明的包：微信登录、支付宝支付 / 签约都要先判断是否安装再拉起。 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.eg.android.AlipayGphone" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
        <!-- SDAppModule.canOpenUrl / openUrl 会探测或拉起的 scheme。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
