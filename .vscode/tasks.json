{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: 编译 shared",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs compile",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Android: 安装并启动 Debug",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs install",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Android: 安装并启动 Debug（测试环境）",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs install-test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Android: 安装热重载包并启动",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs install-hot",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Android: 热重载",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs hot",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Android: 启动模拟器",
      "type": "shell",
      "command": "node scripts/vscode/run.mjs emulator",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
